%% PharmaGen PRO — Pipeline (data flow)
%% Render: mermaid-cli  ->  mmdc -i pipeline.mmd -o ../images/pipeline.svg
flowchart TD
    SSOT["SSOT<br/>SKU.csv + master.json"]:::ssot

    SSOT --> S1["Stage 1 — Passport Generator<br/>src/passport_generator.py"]:::stage
    JSON["pipeline/passports/*.json"]:::data --> S1
    S1 --> MD["Markdown Passports<br/>pipeline/passports.markdown/*.md"]:::data

    MD --> S2["Stage 2 — AI Renderer (RPA)<br/>src/rpa_orchestrator.py<br/>Selenium → Gemini"]:::stage
    S2 --> PNG["PNG Output<br/>render_output/raw/*.png"]:::data

    PNG --> S3["Stage 3 — WEBP Optimizer<br/>src/image_processor.py"]:::stage
    S3 --> WEBP["Final Assets<br/>output/*.webp · 1600×1600 · ≤500 KB"]:::final

    classDef ssot fill:#e8f0fe,stroke:#4285f4,color:#000;
    classDef stage fill:#fff4e5,stroke:#f5a623,color:#000;
    classDef data fill:#f1f3f4,stroke:#9aa0a6,color:#000;
    classDef final fill:#e6f4ea,stroke:#34a853,color:#000;
